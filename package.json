{
  "name": "lynvo-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "check:plugin-server-release": "node scripts/verify-plugin-server-release.mjs",
    "dev": "pnpm --filter @lynvo/app dev",
    "dev:local": "pnpm --filter @lynvo/app dev:local",
    "test": "pnpm --workspace-concurrency=1 -r --if-present run test --run",
    "deploy:lynvo": "pnpm --filter @lynvo/app deploy",
    "images:optimize": "node scripts/optimize-images.mjs apps/lynvo/public/icons/players",
    "sync:repos": "tsx scripts/sync-repos.ts",
    "secrets:local": "node scripts/ensure-lynvo-plugin-server-local-secret.mjs"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "tsx": "^4.23.11",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.26.1"
}
