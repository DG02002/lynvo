{
  "name": "lynvo-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run fmt:check && oxlint scripts && pnpm run lint:markdown && pnpm -r --if-present run check && knip && pnpm run knip:production",
    "check:plugin-server-release": "node scripts/verify-plugin-server-release.mjs",
    "dev": "pnpm --filter @lynvo/app dev",
    "test": "pnpm --workspace-concurrency=1 -r --if-present run test --run",
    "test:workers": "pnpm --filter @lynvo/app test:workers",
    "images:optimize": "node scripts/optimize-images.mjs apps/lynvo/public/icons/players",
    "lint": "oxlint scripts && pnpm run lint:markdown && pnpm -r --if-present run lint",
    "lint:markdown": "markdownlint-cli2",
    "prepare": "husky",
    "seed": "pnpm --filter @lynvo/app seed",
    "sync:repos": "tsx scripts/sync-repos.ts",
    "knip": "knip",
    "fmt": "oxfmt package.json knip.json lint-staged.config.mjs .oxlintrc.json .oxfmtrc.json",
    "fmt:check": "oxfmt package.json knip.json lint-staged.config.mjs .oxlintrc.json .oxfmtrc.json --check",
    "knip:production": "knip --production --include files,dependencies"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "catalog:",
    "knip": "^6.35.1",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "26.9.0"
  }
}
