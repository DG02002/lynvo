{
  "name": "lynvo-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm -r --if-present run check",
    "dev": "pnpm --filter @lynvo/app dev",
    "dev:local": "pnpm --filter @lynvo/app dev:local",
    "test": "pnpm -r --if-present run test --run",
    "deploy:lynvo": "pnpm --filter @lynvo/app deploy",
    "images:optimize": "node scripts/optimize-plugin-icons.mjs apps/lynvo/public/icons/plugins && node scripts/optimize-plugin-icons.mjs apps/lynvo/public/icons/players",
    "sync:repos": "tsx scripts/sync-repos.ts"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.26.1"
}
