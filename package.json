{
  "name": "lynvo-workspace",
  "private": true,
  "packageManager": "pnpm@12.0.0-rc.8+sha512.mmOJqeXlh1fc2f4BG6gmN9tGQOD9+zc+wzVuXK9s+cvWrXaQsDD2eRU7M9QMJKm+blPnU0/B8Q3cqFXn8dci1g==",
  "engines": {
    "node": "26.7.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "oxlint scripts && pnpm -r --if-present run check",
    "check:plugin-server-release": "node scripts/verify-plugin-server-release.mjs",
    "dev": "pnpm --filter @lynvo/app dev",
    "dev:local": "pnpm --filter @lynvo/app dev:local",
    "test": "pnpm --workspace-concurrency=1 -r --if-present run test --run",
    "deploy:lynvo": "pnpm --filter @lynvo/app run deploy",
    "images:optimize": "node scripts/optimize-images.mjs apps/lynvo/public/icons/players",
    "lint": "oxlint scripts && pnpm -r --if-present run lint",
    "prepare": "husky",
    "sync:repos": "tsx scripts/sync-repos.ts",
    "secrets:local": "node scripts/ensure-lynvo-plugin-server-local-secret.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:"
  }
}
