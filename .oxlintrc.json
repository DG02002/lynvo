{
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".repos/**",
    ".roo/**",
    ".windsurf/**",
    // These CLI-generated shadcn primitives are read-only. This excludes
    // every lint rule here, including shadcn's raw-color and inline-style rules.
    "apps/lynvo/app/components/ui/**",
    "tools/oxlint/anti-slop/**",
    "**/worker-configuration.d.ts"
  ],
  "jsPlugins": [
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    },
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "plugins": ["typescript", "unicorn", "react-hooks", "oxc", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "overrides": [
    {
      "files": ["apps/lynvo-plugin-server/src/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      // Unit tests exercise feature internals on purpose; the boundary
      // guards production imports.
      "files": ["apps/lynvo/tests/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "apps/lynvo/app/components/save-list/use-finder-browser-state.ts"
      ],
      "rules": {
        "max-statements": "off"
      }
    },
    {
      "files": ["apps/lynvo/app/entry.server.tsx"],
      "rules": {
        "max-params": "off"
      }
    },
    {
      "files": ["apps/lynvo/app/lib/player-utils.ts"],
      "rules": {
        "consistent-function-scoping": "off"
      }
    },
    {
      "files": ["packages/plugin-server-protocol/src/runtime.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": [
        "apps/lynvo/tests/**",
        "apps/lynvo-plugin-server/tests/**",
        "packages/plugin-server-protocol/tests/**",
        "packages/create-lynvo-plugin-server/tests/**"
      ],
      "plugins": ["typescript", "vitest"],
      "rules": {
        "consistent-function-scoping": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-await-in-loop": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/hoisted-apis-on-top": "error",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/valid-expect": "off",
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off",
        "vitest/expect-expect": "off"
      }
    }
  ],
  "rules": {
    // Feature folders expose entry points at fixed depths. These patterns block
    // deep aliased imports and relative paths containing `features/<name>/`.
    // `links` and `auth` allow one path segment; `site` allows two. Keep the
    // feature groups explicit when a new feature adopts this boundary.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(?:~/|(?:\\.\\.?/)+.*)features/(links|auth)/[^/]+/.+$",
            "message": "Import feature internals through a feature entry point."
          },
          {
            "regex": "^(?:~/|(?:\\.\\.?/)+.*)features/site/[^/]+/[^/]+/.+$",
            "message": "Import feature internals through a feature entry point."
          }
        ]
      }
    ],
    // `layout` classes (margin, width, flex, positioning) are page-level
    // decisions, so restyling those on a shadcn primitive stays allowed.
    // Color, typography, spacing, and shape overrides must go through
    // variants or wrapper elements instead of ad-hoc classNames.
    "shadcn/no-restyle": [
      "warn",
      {
        "allow": ["layout"],
        "contracts": [
          {
            // Tabs and TabsList are the flex containers for tab panels and
            // triggers; the gap between their children is theirs to set, so
            // inter-child spacing stays allowed on them.
            "pattern": "^(Tabs|TabsList)$",
            "allow": ["layout", "gap-*"]
          },
          {
            // Menu triggers embedded in media rows and gallery artwork
            // reshape Button past its variants: a square cell-filling hit
            // target on ghost, or a round overlay dot on overlay. Shape and
            // resting foreground are the whole restyle; the shared look
            // lives in components/menu-trigger-button.tsx.
            "pattern": "^Button$",
            "allow": [
              "layout",
              "text-foreground",
              "rounded-none",
              "rounded-full"
            ]
          },
          {
            // Settings rows render every select as a quiet inline value
            // control: transparent, borderless, focus-ring-free, muted
            // hover. These classes are that one shared look, defined in
            // SettingsSelectTrigger in features/site/settings.
            "pattern": "^SelectTrigger$",
            "allow": [
              "layout",
              "bg-transparent",
              "border-transparent",
              "rounded-xl",
              "text-foreground",
              "hover:bg-muted",
              "px-2.5",
              "py-1",
              "gap-1",
              "focus-visible:ring-0"
            ]
          }
        ]
      }
    ],
    // Colors must come from the theme tokens in apps/lynvo/app/app.css, so
    // raw palette and hex classes stay out of feature code.
    "shadcn/no-raw-colors": "warn",
    // Arbitrary values like p-[13px] drift from the theme scale; use the
    // nearest scale class instead. `layout` still allows positioning and
    // sizing values that cannot land on the grid (z-index, calc() widths,
    // absolute offsets).
    "shadcn/no-arbitrary-values": [
      "warn",
      {
        "allow": ["layout"]
      }
    ],
    // Inline styles escape the class system entirely; dynamic values move
    // through CSS custom properties and static classes instead.
    "shadcn/no-inline-styles": "warn",
    // Class strings built by template literals or concatenation cannot be
    // checked against the design system; conditional maps and cn() with
    // static strings keep every class visible to the linter.
    "shadcn/require-static-classes": "warn",
    // Every class must resolve to a Tailwind utility, a theme token, or a
    // rule declared in app.css, so typos and dead classes surface at lint
    // time instead of as silently missing styles.
    "shadcn/no-unknown-classes": "warn",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "warn",
    "react/set-state-in-effect": "warn",
    "react/memo-dependencies": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/no-array-index-key": "warn",
    "react/use-memo": "warn",
    "react/globals": "warn",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-react-children": "warn",
    "react/hook-use-state": "warn",
    "react/no-unescaped-entities": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "sonarjs/no-identical-functions": "warn",
    "import/no-unassigned-import": "off",
    // SAFETY comments are the repository's assertion gate; this rule would
    // repeat those approved assertions.
    "typescript/no-unsafe-type-assertion": "off",
    "no-promise-executor-return": "error",
    "eqeqeq": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "curly": "warn",
    "no-eval": "warn",
    "no-implied-eval": "warn",
    "max-statements": [
      "warn",
      {
        "max": 20
      }
    ],
    "max-params": "warn",
    "no-nested-ternary": "warn",
    "no-extra-boolean-cast": "warn",
    "no-await-in-loop": "warn",
    "prefer-destructuring": "warn",
    "no-duplicate-imports": "warn",
    "no-useless-catch": "warn",
    "consistent-type-imports": "warn",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag", "__BUILD_TIME__"]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
