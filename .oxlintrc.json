{
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".repos/**",
    ".roo/**",
    ".windsurf/**",
    "apps/lynvo/app/components/ui/**",
    "tools/oxlint/anti-slop/**",
    "**/worker-configuration.d.ts"
  ],
  "jsPlugins": [
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "plugins": ["typescript", "unicorn", "react-hooks", "oxc", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "overrides": [
    {
      "files": ["apps/lynvo-plugin-server/src/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      // Unit tests exercise feature internals on purpose; the boundary
      // guards production imports.
      "files": ["apps/lynvo/tests/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "apps/lynvo/app/components/save-list/use-finder-browser-state.ts"
      ],
      "rules": {
        "max-statements": "off"
      }
    },
    {
      "files": ["apps/lynvo/app/entry.server.tsx"],
      "rules": {
        "max-params": "off"
      }
    },
    {
      "files": ["apps/lynvo/app/lib/player-utils.ts"],
      "rules": {
        "consistent-function-scoping": "off"
      }
    },
    {
      "files": ["packages/plugin-server-protocol/src/runtime.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": [
        "apps/lynvo/tests/**",
        "apps/lynvo-plugin-server/tests/**",
        "packages/plugin-server-protocol/tests/**",
        "packages/create-lynvo-plugin-server/tests/**"
      ],
      "plugins": ["typescript", "vitest"],
      "rules": {
        "consistent-function-scoping": "off",
        "max-params": "off",
        "max-statements": "off",
        "no-await-in-loop": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/hoisted-apis-on-top": "error",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/valid-expect": "off",
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off",
        "vitest/expect-expect": "off"
      }
    }
  ],
  "rules": {
    // Feature folders are modules: outside code imports their entry points
    // (root files such as `~/features/links/types`, folder indexes such as
    // `~/features/links/use-links`) and never their internals. `site` has no
    // root files, so its subfolders are the modules and their root files are
    // the entry points.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "~/features/links/**",
          "!~/features/links/*",
          "~/features/site/**",
          "!~/features/site/*",
          "!~/features/site/*/*",
          "~/features/auth/**",
          "!~/features/auth/*"
        ]
      }
    ],
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "warn",
    "react/set-state-in-effect": "warn",
    "react/memo-dependencies": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/no-array-index-key": "warn",
    "react/use-memo": "warn",
    "react/globals": "warn",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-react-children": "warn",
    "react/hook-use-state": "warn",
    "react/no-unescaped-entities": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "sonarjs/no-identical-functions": "warn",
    "import/no-unassigned-import": "off",
    // SAFETY comments are the repository's assertion gate; this rule would
    // repeat those approved assertions.
    "typescript/no-unsafe-type-assertion": "off",
    "no-promise-executor-return": "error",
    "eqeqeq": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "curly": "warn",
    "no-eval": "warn",
    "no-implied-eval": "warn",
    "max-statements": [
      "warn",
      {
        "max": 20
      }
    ],
    "max-params": "warn",
    "no-nested-ternary": "warn",
    "no-extra-boolean-cast": "warn",
    "no-await-in-loop": "warn",
    "prefer-destructuring": "warn",
    "no-duplicate-imports": "warn",
    "no-useless-catch": "warn",
    "consistent-type-imports": "warn",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag", "__BUILD_TIME__"]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
