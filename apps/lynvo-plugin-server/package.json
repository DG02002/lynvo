{
  "name": "@lynvo/lynvo-plugin-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:protocol && wrangler deploy --dry-run --config wrangler.jsonc --env=\"\"",
    "dev": "pnpm run prepare:protocol && wrangler dev --config wrangler.jsonc --env local",
    "deploy": "pnpm run images:optimize && pnpm run check && pnpm run test && wrangler deploy --config wrangler.jsonc --env=\"\"",
    "images:optimize": "node ../../scripts/optimize-images.mjs public/icons/sources",
    "cf-typegen": "wrangler types --env-interface LynvoPluginServerBindings",
    "check": "pnpm run prepare:protocol && pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "fmt": "oxfmt src tests vitest.config.ts",
    "fmt:check": "oxfmt src tests vitest.config.ts --check",
    "lint": "oxlint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:protocol": "pnpm --filter @dg02002/lynvo-plugin-server-protocol build",
    "test": "pnpm run prepare:protocol && vitest run",
    "test:watch": "pnpm run prepare:protocol && vitest"
  },
  "dependencies": {
    "@dg02002/lynvo-plugin-server-protocol": "workspace:*",
    "cheerio": "catalog:",
    "evlog": "2.25.0",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
