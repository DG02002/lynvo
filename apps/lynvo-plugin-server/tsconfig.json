{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext",
      "WebWorker"
    ],
    "types": [
      "vite/client",
      "@cloudflare/vitest-plugin/types",
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "tests",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
