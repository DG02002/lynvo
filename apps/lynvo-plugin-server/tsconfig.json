{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": [
      "vite/client",
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests", "vitest.config.ts", "worker-configuration.d.ts"]
}
