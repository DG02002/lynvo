{
  "name": "@lynvo/app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:protocol && react-router build",
    "clean": "rm -rf build .react-router",
    "dev": "pnpm run prepare:protocol && node scripts/start-local-dev.mjs",
    "preview": "pnpm run build && vite preview",
    "seed": "tsx scripts/seed.ts",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "test": "pnpm run prepare:protocol && vitest",
    "test:workers": "vitest -c vitest.workers.config.ts --run",
    "lint": "oxlint app workers scripts tests",
    "lint:fix": "oxlint app workers scripts tests --fix",
    "fmt": "oxfmt app workers scripts tests package.json",
    "fmt:check": "oxfmt app workers scripts tests package.json --check",
    "typecheck": "pnpm run prepare:protocol && pnpm run cf-typegen && react-router typegen && node scripts/typecheck.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm --workspace-root images:optimize && pnpm run preflight && pnpm run check && pnpm run test --run && pnpm run build && wrangler deploy --config build/server/wrangler.json --env=\"\" --var \"COMMIT_HASH:$COMMIT_HASH\" --var \"SERVICE_VERSION:$SERVICE_VERSION\"",
    "prepare:protocol": "pnpm --filter @dg02002/lynvo-plugin-server-protocol build",
    "preflight": "node scripts/deployment-preflight.mjs",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dg02002/lynvo-plugin-server-protocol": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-form": "1.33.5",
    "cheerio": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "effect": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "isbot": "^5.2.2",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@edge-runtime/vm": "^5.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^8.3.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "^1.63.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
