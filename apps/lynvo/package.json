{
  "name": "@lynvo/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:protocol && react-router build",
    "clean": "rm -rf build .react-router",
    "dev:local": "pnpm run prepare:protocol && node scripts/start-local-dev.mjs",
    "dev": "pnpm run prepare:protocol && react-router dev",
    "preview": "pnpm run build && vite preview",
    "test": "pnpm run prepare:protocol && vitest",
    "test:workers": "vitest -c vitest.workers.config.ts --run",
    "lint": "oxlint app workers scripts",
    "lint:fix": "oxlint app workers scripts --fix",
    "fmt": "oxfmt app workers scripts",
    "fmt:check": "oxfmt app workers scripts --check",
    "typecheck": "pnpm run prepare:protocol && pnpm run cf-typegen && react-router typegen && node scripts/typecheck.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm --workspace-root images:optimize && pnpm run preflight && pnpm run check && pnpm run test --run && pnpm run build && wrangler deploy --config build/server/wrangler.json --env=\"\" --var \"COMMIT_HASH:$COMMIT_HASH\" --var \"SERVICE_VERSION:$SERVICE_VERSION\"",
    "prepare:protocol": "pnpm --filter @dg02002/lynvo-plugin-server-protocol build",
    "preflight": "node scripts/deployment-preflight.mjs",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dg02002/lynvo-plugin-server-protocol": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-form": "1.33.4",
    "cheerio": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "rc",
    "evlog": "2.25.0",
    "hono": "catalog:",
    "input-otp": "^1.4.2",
    "isbot": "^5.2.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "shadcn": "4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "catalog:",
    "@edge-runtime/vm": "^5.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^8.3.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
