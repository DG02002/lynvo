{
  "name": "@lynvo/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rm -rf build .react-router",
    "dev:local": "convex dev --start 'node scripts/prepare-local-dev-vars.mjs && CLOUDFLARE_ENV=local react-router dev'",
    "dev": "react-router dev",
    "dev:cloud": "react-router dev",
    "preview": "pnpm run build && vite preview",
    "test": "vitest",
    "lint": "oxlint app workers convex scripts",
    "lint:fix": "oxlint app workers convex scripts --fix",
    "fmt": "oxfmt app workers convex scripts '!convex/_generated/**'",
    "fmt:check": "oxfmt app workers convex scripts '!convex/_generated/**' --check",
    "typecheck": "pnpm run cf-typegen && react-router typegen && node scripts/typecheck.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm --workspace-root images:optimize && pnpm run build && wrangler deploy",
    "usage:reset": "convex run usage:resetAll",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/auth": "^0.0.94",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@lynvo/extractor-protocol": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "cheerio": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "effect": "beta",
    "hono": "catalog:",
    "input-otp": "^1.4.2",
    "isbot": "^5.2.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "catalog:",
    "@edge-runtime/vm": "^5.0.0",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^29.1.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
