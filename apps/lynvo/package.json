{
  "name": "@lynvo/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rm -rf build .react-router",
    "dev:local": "node scripts/start-local-dev.mjs",
    "dev": "react-router dev",
    "dev:cloud": "react-router dev",
    "preview": "pnpm run build && vite preview",
    "test": "vitest",
    "lint": "oxlint app workers convex scripts",
    "lint:fix": "oxlint app workers convex scripts --fix",
    "fmt": "oxfmt app workers convex scripts '!convex/_generated/**'",
    "fmt:check": "oxfmt app workers convex scripts '!convex/_generated/**' --check",
    "typecheck": "pnpm run cf-typegen && react-router typegen && node scripts/typecheck.mjs",
    "audit:convex-contracts": "node scripts/audit-convex-contracts.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run audit:convex-contracts && pnpm run typecheck",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm --workspace-root images:optimize && pnpm run preflight && pnpm run check && pnpm run test --run && pnpm run build && wrangler deploy",
    "preflight": "node scripts/deployment-preflight.mjs",
    "usage:reset": "convex run usage:resetAll",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/migrations": "^0.3.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@lynvo/plugin-server-protocol": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "cheerio": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "effect": "beta",
    "evlog": "^2.22.4",
    "hono": "catalog:",
    "input-otp": "^1.4.2",
    "isbot": "^5.2.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.49.0",
    "@cloudflare/workers-types": "catalog:",
    "@edge-runtime/vm": "^5.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^8.3.0",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/rehype": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@shikijs/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.54",
    "jsdom": "^30.0.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
