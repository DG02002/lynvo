{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "app/features/site/docs/docs-frontmatter.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
