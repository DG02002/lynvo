{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["app/components/ui/**"],
    "overrides": [
      {
        "files": ["tests/**"],
        "rules": [
          "eslint/max-statements",
          "eslint/max-params",
          "eslint/no-await-in-loop"
        ]
      },
      {
        "files": ["app/entry.server.tsx"],
        "rules": ["eslint/max-params"]
      },
      {
        "files": ["app/**/routes/*.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "app/features/site/docs/docs-components.tsx",
          "app/root/route-seo-metadata.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "app/features/site/content/privacy-policy-content.tsx",
          "app/features/site/home/home-save-demo.tsx"
        ],
        "rules": ["react-doctor/no-giant-component"]
      }
    ]
  },
  "supplyChain": {
    "enabled": false
  }
}
