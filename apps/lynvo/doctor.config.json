{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["app/components/ui/**", "convex/_generated/**"],
    "overrides": [
      {
        "files": ["app/**/routes/*.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "app/features/site/docs/docs-components.tsx",
          "app/root/route-seo-metadata.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "convex/accountErasure.ts",
          "convex/accountLifecycle.ts",
          "convex/migrations.ts",
          "convex/storagePolicy.ts",
          "convex/userPluginServers.ts",
          "convex/users.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": ["convex/accountDataOwnership.ts"],
        "rules": ["react-doctor/js-combine-iterations"]
      }
    ]
  },
  "supplyChain": {
    "enabled": false
  }
}
