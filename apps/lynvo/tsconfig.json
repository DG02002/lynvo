{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.cloudflare.json"
    }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "types": [
      "./worker-configuration.d.ts"
    ],
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  }
}
