{
  "name": "@dg02002/lynvo-plugin-server-protocol",
  "version": "0.1.5",
  "description": "Lynvo Custom Plugin Server protocol schemas, runtime helpers, and metadata utilities.",
  "keywords": [
    "cloudflare-workers",
    "hono",
    "lynvo",
    "plugin-server",
    "protocol"
  ],
  "homepage": "https://github.com/DG02002/lynvo/tree/main/packages/plugin-server-protocol",
  "bugs": {
    "url": "https://github.com/DG02002/lynvo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DG02002/lynvo.git",
    "directory": "packages/plugin-server-protocol"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "oxlint src tests scripts",
    "prepack": "pnpm run release:check",
    "release:check": "pnpm run build && node scripts/release-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.7.0"
  }
}
