{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "A Lynvo-compatible Custom Plugin Server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "images:optimize": "node scripts/optimize-images.mjs public/icons/sources",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "pnpm run images:optimize && wrangler deploy --dry-run --config wrangler.jsonc --env=\"\"",
    "deploy": "pnpm run images:optimize && wrangler deploy --config wrangler.jsonc --env=\"\""
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "dependencies": {
    "@dg02002/lynvo-plugin-server-protocol": "^__LYNVO_PROTOCOL_VERSION__",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
